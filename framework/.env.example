# .env — Betat community environment variables
# `betat init` writes the live .env for you (SECRET_KEY generated,
# accountability fields filled in). This file is a reference only —
# copy relevant values to your server's real environment for production
# deployments (Render, Railway, systemd, etc. — not a checked-in .env file).
#
# [DEV]  Fine to leave most of this unset for local development.
# [PROD] Set these as server environment variables.

# ── Security ──────────────────────────────────────────────────────────────

# [DEV] Auto-generated by betat init on first run — no action needed.
# [PROD] Rotate this key if it was ever exposed. Generate a new one:
#        python -c "import secrets; print(secrets.token_urlsafe(50))"
BETAT_SECRET_KEY=<generated_by_betat_init>

# [DEV] Leave unset — defaults to true (enables debug pages, relaxed host checks).
# [PROD] Must be false — true exposes internal server information.
BETAT_DEBUG=false

# [DEV] Leave unset.
# [PROD] Required once BETAT_DEBUG=false. Comma-separated list of hosts this
#        community serves, e.g.: archive.yourcommunity.org
BETAT_ALLOWED_HOSTS=

# ── Database ──────────────────────────────────────────────────────────────

# [DEV] Leave unset to use SQLite (zero configuration, fine for development).
# [PROD] Set to your PostgreSQL connection URL for production:
#        BETAT_DB=postgresql://user:password@host:5432/dbname
# BETAT_DB=

# Optional: isolate Betat's tables in a specific PostgreSQL schema.
# Only relevant when using PostgreSQL (BETAT_DB is set).
# First create the schema in psql: CREATE SCHEMA betatschema;
# Then set: BETAT_DB_SCHEMA=betatschema
# See framework-production.md before using this in production — the
# documented REVOKE/GRANT role setup is written against the default
# 'public' schema and needs adapting to a custom schema by hand for now.
# [DEV] Leave unset.
# [PROD] Set if sharing a PostgreSQL server with other applications.
# BETAT_DB_SCHEMA=

# ── Operator accountability (written by betat init) ───────────────────────

BETAT_OPERATOR_EMAIL=
BETAT_DECLARATION_ACCEPTED=true
BETAT_DECLARED_COMMUNITY_ID=

# ── Optional: registry (written by betat init if chosen) ──────────────────

# URL of the Betat registry endpoint for community announcements.
# Leave unset if you are not registering with a registry yet.
# BETAT_REGISTRY_URL=
